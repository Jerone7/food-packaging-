  "glossary": {
    "wvtr_title": "Water Vapor Transmission Rate (WVTR)",
    "wvtr_desc": "Measures the rate of moisture permeating through a barrier film. Low WVTR prevents dry foods from absorbing humidity and fresh produce from dehydrating.",
    "otr_title": "Oxygen Transmission Rate (OTR)",
    "otr_desc": "Measures the volume of oxygen gas passing through the packaging. Low OTR prevents rancidity, microbial growth, and discoloration.",
    "aw_title": "Water Activity (aw)",
    "aw_desc": "The measure of unbound water available for microbial growth. Foods with aw > 0.85 require hermetic seals or active gas preservation.",
    "emap_title": "Equilibrium Modified Atmosphere Packaging (EMAP)",
    "emap_desc": "A preservation technique matching film permeability with produce respiration rate to maintain optimal O₂ (3-5%) and CO₂ (3-8%) gas concentrations.",
    "astm_d6400_title": "ASTM D6400 / EN 13432 Composting",
    "astm_d6400_desc": "International standard certifying that packaging completely disintegrates and biodegrades into non-toxic compost within 180 days."
  }
